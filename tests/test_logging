import logging

def test_logging(caplog):
    """
    Verifica que el sistema registra mensajes de log durante
    el procesamiento. Se utiliza caplog de pytest para capturar
    los mensajes emitidos por el logger 'ocr_system'.
    """

    logger = logging.getLogger("ocr_system")

    with caplog.at_level(logging.INFO):
        logger.info("Processing image")

    assert "Processing image" in caplog.text
